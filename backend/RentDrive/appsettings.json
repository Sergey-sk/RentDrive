{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=RentDrive;Uid=root;Password=YOUR_LOCAL_DB_PASSWORD;"
  },
  "EmailSettings": {
    "SmtpServer": "SmtpServer",
    "Port": 587,
    "SenderEmail": "SenderEmail",
    "Password": "YOUR_APP_PASSWORD"
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/rentdrive-log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
